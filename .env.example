# Adaptive LP Vault 部署环境变量示例
# 对应 script/Deploy.s.sol、script/Configure.s.sol、script/Bootstrap.s.sol。
# 使用方式：复制为 .env，替换所有 YOUR_* 占位值并审核数值，然后加载：
#   cp .env.example .env
#   set -a; source .env; set +a
# .env 已被 Git 忽略；禁止在本示例文件中填入真实私钥或带凭据的 RPC URL。
# 下列数值仅与部署手册中的示例保持一致，不是生产推荐值。
# 执行顺序：Deploy -> Configure -> Bootstrap；广播前先在目标网络模拟。

# ── 网络 ──
# 供 forge script --rpc-url "$RPC_URL" 使用，Solidity 脚本不直接读取此变量。
RPC_URL="https://YOUR_RPC_ENDPOINT"

# ── Fork 测试（独立于部署脚本）──
# 需要支持固定区块历史存储读取的 Ethereum 主网归档 RPC；不需要任何私钥。
# 执行：FOUNDRY_PROFILE=fork forge test -vv
# 详见 test/fork/README.md。覆盖区块不会自动放宽历史市场状态断言。
MAINNET_RPC_URL="https://YOUR_ETHEREUM_ARCHIVE_RPC"
MAINNET_FORK_BLOCK=21000000

# ── 执行账户与权限 ──
# 私钥使用 0x 前缀的 32 字节十六进制字符串；以下占位值故意不可用。
DEPLOYER_PRIVATE_KEY=0xYOUR_DEPLOYER_PRIVATE_KEY
ADMIN_PRIVATE_KEY=0xYOUR_ADMIN_PRIVATE_KEY
MANAGER_PRIVATE_KEY=0xYOUR_MANAGER_PRIVATE_KEY

# DEFAULT_ADMIN 必须对应 ADMIN_PRIVATE_KEY，MANAGER 必须对应 MANAGER_PRIVATE_KEY。
# 所有地址均需替换为目标网络的真实地址，角色账户不得为零地址。
DEFAULT_ADMIN=0xYOUR_DEFAULT_ADMIN_ADDRESS
MANAGER=0xYOUR_MANAGER_ADDRESS
GUARDIAN=0xYOUR_GUARDIAN_ADDRESS
KEEPER=0xYOUR_KEEPER_ADDRESS

# ── 外部协议地址（Deploy）──
# 从目标网络的官方部署信息获取并核验，不能跨网络复用。
# 四个池必须使用相同的 token0/token1 及顺序，并属于对应 Factory。
# CANONICAL_POOL 是定价用的 Uniswap V3 池；LOW/HIGH_FEE_POOL 是策略用的 V3 池。
CANONICAL_POOL=0xYOUR_CANONICAL_UNISWAP_V3_POOL
V2_POOL=0xYOUR_UNISWAP_V2_PAIR
LOW_FEE_POOL=0xYOUR_LOW_FEE_UNISWAP_V3_POOL
HIGH_FEE_POOL=0xYOUR_HIGH_FEE_UNISWAP_V3_POOL
UNISWAP_V2_FACTORY=0xYOUR_UNISWAP_V2_FACTORY
UNISWAP_V3_FACTORY=0xYOUR_UNISWAP_V3_FACTORY
ROUTER=0xYOUR_APPROVED_UNISWAP_V3_ROUTER
POSITION_MANAGER=0xYOUR_UNISWAP_V3_POSITION_MANAGER

# ── 预言机（Deploy）──
# 时间加权平均价格（TWAP）窗口，单位：秒。
# 0 < SHORT_TWAP_WINDOW_SECONDS < TWAP_WINDOW_SECONDS；池需有足够历史记录。
TWAP_WINDOW_SECONDS=1800
SHORT_TWAP_WINDOW_SECONDS=300

# ── Vault 固定配置（Deploy）──
# 含空格的值必须加引号，以便通过 source 加载。
VAULT_NAME="Adaptive LP Vault"
VAULT_SYMBOL="ALPV"
# 可接受的舍入残余，分别以 token0/token1 最小单位计量。
DUST_TOLERANCE0=1
DUST_TOLERANCE1=1
# 初始化时永久锁定的份额数量，使用份额最小单位，必须大于零。
MINIMUM_LOCKED_SHARES=1000000000000000
# 最低初始净资产价值（NAV），以 token1 最小单位计量，必须大于零。
MINIMUM_INITIAL_NAV=1
# 默认管理员转移延迟，单位：秒。
DEFAULT_ADMIN_DELAY=86400

# ── 策略固定配置（Deploy）──
# 再平衡冷却时间，单位：秒。
MIN_REBALANCE_COOLDOWN=3600
# BPS 表示基点：100 BPS = 1%，10000 BPS = 100%。
# 偏离阈值需满足：
# EXIT_MEDIUM < ENTER_MEDIUM <= EXIT_HIGH < ENTER_HIGH <= EXIT_EXTREME < ENTER_EXTREME <= 10000。
ENTER_MEDIUM_BPS=100
EXIT_MEDIUM_BPS=50
ENTER_HIGH_BPS=300
EXIT_HIGH_BPS=200
ENTER_EXTREME_BPS=1000
EXIT_EXTREME_BPS=800
# V3 区间半宽，以对应池的 tickSpacing 步数计量，均须大于零。
NARROW_RANGE_HALF_WIDTH_STEPS=10
WIDE_RANGE_HALF_WIDTH_STEPS=50
# 重新居中所需的最小位移，相对于当前区间半宽，范围 0..10000 BPS。
MIN_RECENTER_BPS=2500
# 健康部署后允许的最大闲置资产比例，范围 0..9999 BPS。
MAX_HEALTHY_IDLE_BPS=500
# 最大换币滑点，范围 1..10000 BPS。
MAX_SWAP_SLIPPAGE_BPS=100
# 最大迁移净资产损失比例，范围 0..10000 BPS。
MAX_MIGRATION_LOSS_BPS=50

# ── 一次性初始化（Bootstrap，须先完成 Configure）──
# BOOTSTRAP_SENDER 必须等于 MANAGER，且对应 MANAGER_PRIVATE_KEY。
# Sender 必须持有足够的两种 Token；Receiver 接收扣除永久锁定份额后的初始份额。
BOOTSTRAP_SENDER=0xYOUR_MANAGER_ADDRESS
BOOTSTRAP_RECEIVER=0xYOUR_INITIAL_SHARE_RECEIVER
# 分别使用 token0/token1 最小单位，均须大于零；此处的 1 仅为占位示例。
# 需满足最低 NAV、初始总份额大于锁定份额及策略最低部署比例。
# 初始化不执行换币，应根据池价格、Token 精度和策略审核两种资产的投入比例。
BOOTSTRAP_AMOUNT0=1
BOOTSTRAP_AMOUNT1=1

# ── 部署清单（可选，三个脚本共用）──
# 不设置时默认为 deployments/<chainId>.json。
# Deploy 写入，Configure 和 Bootstrap 读取；各阶段必须使用同一份清单。
# 自定义路径时需保证父目录存在，且 Foundry 文件系统权限允许读写。
# DEPLOYMENT_FILE="deployments/1.json"
